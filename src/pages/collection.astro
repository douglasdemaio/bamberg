---
import BaseLayout from '../layouts/BaseLayout.astro';
import sites from '../../sites.json';

const categories = [
  { id: 'seven-hills', i18nKey: 'index.cat_seven_hills', icon: '⛰' },
  { id: 'stone-and-power', i18nKey: 'index.cat_stone_and_power', icon: '🏛' },
  { id: 'water-and-bridges', i18nKey: 'index.cat_water_and_bridges', icon: '🌉' },
  { id: 'beer', i18nKey: 'index.cat_beer', icon: '🍺' },
  { id: 'gardens-guilds-trades', i18nKey: 'index.cat_gardens_guilds_trades', icon: '🌿' },
  { id: 'ghosts-curiosities-archive', i18nKey: 'index.cat_ghosts_curiosities_archive', icon: '🔍' },
];
---

<BaseLayout title="Meine Sammlung – Bamberg Quest" description="Deine erkundeten Sehenswürdigkeiten in Bamberg.">
  <header class="page-header">
    <h1><span data-i18n="collection.title">Meine Karte</span></h1>
    <nav class="nav-links">
      <a href="/">← <span data-i18n="nav.overview">Übersicht</span></a>
      <a href="/trails"><span data-i18n="nav.trails">Routen</span></a>
      <a href="/passport"><span data-i18n="nav.beerpass">Bierpass</span></a>
      <a href="/party">🎉 <span data-i18n="nav.party">Party</span></a>
      <a href="/plan"><span data-i18n="nav.plan">Planen</span></a>
    </nav>
    <div class="progress-bar" id="progress-bar" data-total={sites.length}>
      <div class="progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
    <p class="progress-text">
      <span id="claim-collection-count">0</span> / {sites.length} 
      <span id="progress-label" class="progress-label" data-i18n="collection.explored">erkundet</span>
    </p>
  </header>

  <main>
    <section class="map-tiles" id="map-tiles" aria-label="Kartenkacheln / Map tiles">
      {sites.map(site => {
        const cat = categories.find(c => c.id === site.category);
        return (
          <div class="map-tile" id={`tile-${site.slug}`} data-slug={site.slug} data-category={site.category} data-name-de={site.name.de} data-name-en={site.name.en}>
            <a href={`/site/${site.slug}`} class="tile-link">
              <div class="tile-seal" id={`tile-seal-${site.slug}`}>🫱</div>
              <div class="tile-content">
                <span class="tile-name">{site.name.de.split(' ').slice(0, 2).join(' ')}</span>
                <span class="tile-icon">{cat?.icon || '📍'}</span>
              </div>
            </a>
          </div>
        );
      })}
    </section>

    <section class="claimed-list" id="claimed-list" aria-label="Erkundete Orte">
      <h2><span data-i18n="collection.explored">Erkundet</span></h2>
      <ul class="claimed-items" id="claimed-items"></ul>
      <p class="empty-state" id="empty-state"><span data-i18n="collection.empty">Noch keine Orte erkundet.</span> <a href="/"><span data-i18n="collection.empty_link">Beginne hier →</span></a></p>
    </section>

    <section class="export-section" aria-label="Code export / import">
      <h2><span data-i18n="collection.export_title">🔐 Code exportieren</span></h2>
      <details>
        <summary><span data-i18n="collection.export_summary">Code erstellen</span></summary>
        <p class="export-desc"><span data-i18n="collection.export_desc">Erzeuge einen teilbaren Code, der alle deine Erkundungen enthält.</span></p>
        <button type="button" id="export-btn" class="claim-btn"><span data-i18n="collection.export_btn">📋 Generieren</span></button>
        <div class="export-result" id="export-result" hidden>
          <p class="export-label"><span data-i18n="collection.export_your_code">Dein Code:</span></p>
          <textarea id="export-code" class="export-textarea" readonly rows="3"></textarea>
          <button type="button" id="copy-btn" class="claim-btn claim-btn-secondary"><span data-i18n="collection.export_copy">📋 Kopieren</span></button>
          <p class="export-feedback" id="export-feedback"></p>
        </div>
      </details>
      <details>
        <summary><span data-i18n="collection.import_summary">Code importieren</span></summary>
        <p class="export-desc"><span data-i18n="collection.import_desc">Setze einen Code ein, um fremde Erkundungen zu übernehmen.</span></p>
        <textarea id="import-code" class="export-textarea" rows="3" data-i18n-placeholder="collection.import_placeholder" placeholder="Füge Code hier ein"></textarea>
        <button type="button" id="import-btn" class="claim-btn"><span data-i18n="collection.import_btn">📥 Importieren</span></button>
        <p class="export-feedback" id="import-feedback"></p>
      </details>
    </section>
  </main>
</BaseLayout>

<script>
import { getClaimedSlugs, getClaimCount, isClaimed, claimSite } from '../lib/game.js';

function updateCollection() {
  const claimedSlugs = getClaimedSlugs();
  const count = claimedSlugs.length;
  const total = parseInt(document.getElementById('progress-bar')?.dataset?.total || '0', 10);

  document.getElementById('claim-collection-count').textContent = count;

  const fill = document.getElementById('progress-fill');
  if (fill && total > 0) {
    fill.style.width = `${Math.round(count / total * 100)}%`;
  }

  const progressLabel = document.getElementById('progress-label');
  const lang = document.documentElement.lang || 'de';
  if (progressLabel && count === total) {
    progressLabel.textContent = '🎉 ' + (lang === 'de' ? 'Vollständig!' : 'Complete!');
  }

  // Update tiles
  claimedSlugs.forEach(slug => {
    const tile = document.getElementById(`tile-${slug}`);
    const seal = document.getElementById(`tile-seal-${slug}`);
    if (tile) tile.classList.add('tile-claimed');
    if (seal) seal.textContent = '✅';
  });

  // Update claimed list
  const listEl = document.getElementById('claimed-items');
  const emptyEl = document.getElementById('empty-state');
  if (!listEl) return;

  if (count === 0) {
    if (emptyEl) emptyEl.hidden = false;
    return;
  }
  if (emptyEl) emptyEl.hidden = true;

  claimedSlugs.forEach(slug => {
    const tile = document.getElementById(`tile-${slug}`);
    if (!tile) return;
    const nameDe = tile.dataset.nameDe || slug;
    const nameEn = tile.dataset.nameEn || slug;
    const li = document.createElement('li');
    li.className = 'claimed-item';
    li.innerHTML = `<a href="/site/${slug}"><span class="claimed-mark">✅</span> <span class="claimed-name-de">${nameDe}</span> <span class="claimed-name-en">${nameEn}</span></a>`;
    listEl.appendChild(li);
  });
}

// Export / Import
const exportBtn = document.getElementById('export-btn');
const exportResult = document.getElementById('export-result');
const exportCode = document.getElementById('export-code');
const copyBtn = document.getElementById('copy-btn');
const importBtn = document.getElementById('import-btn');
const importCode = document.getElementById('import-code');

if (exportBtn && exportResult) {
  exportBtn.addEventListener('click', () => {
    const data = { v: 1, claims: getClaimedSlugs(), t: Date.now() };
    const json = JSON.stringify(data);
    const code = btoa(unescape(encodeURIComponent(json)));
    exportCode.value = code;
    exportResult.hidden = false;
  });
}

if (copyBtn && exportCode) {
  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(exportCode.value);
      document.getElementById('export-feedback').textContent = '✓ ' + (document.documentElement.lang === 'de' ? 'Kopiert!' : 'Copied!');
    } catch {
      exportCode.select();
      document.execCommand('copy');
      document.getElementById('export-feedback').textContent = '✓ ' + (document.documentElement.lang === 'de' ? 'Kopiert!' : 'Copied!');
    }
  });
}

if (importBtn && importCode) {
  importBtn.addEventListener('click', () => {
    const lang = document.documentElement.lang || 'de';
    const raw = importCode.value.trim();
    if (!raw) {
      document.getElementById('import-feedback').textContent = lang === 'de' ? '✗ Bitte Code einfügen' : '✗ Please paste a code';
      return;
    }
    try {
      const json = decodeURIComponent(escape(atob(raw)));
      const data = JSON.parse(json);
      if (!data.v || !Array.isArray(data.claims)) {
        throw new Error('Invalid format');
      }
      let imported = 0;
      data.claims.forEach(slug => {
        if (!isClaimed(slug)) {
          claimSite(slug, 'import');
          imported++;
        }
      });
      const msg = lang === 'de' ? `✓ ${imported} Orte importiert` : `✓ ${imported} sites imported`;
      document.getElementById('import-feedback').textContent = msg;
      if (imported > 0) updateCollection();
    } catch {
      document.getElementById('import-feedback').textContent = lang === 'de' ? '✗ Ungültiger Code' : '✗ Invalid code';
    }
  });
}

if (document.getElementById('claim-collection-count')) {
  updateCollection();
}
</script>

<style>
  .page-header {
    padding: 2rem 0 1rem;
    border-bottom: 2px solid var(--verdigris);
    margin-bottom: 1.5rem;
  }
  .page-header h1 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }
  .nav-links a { font-weight: 600; }
  .progress-bar {
    height: 8px;
    background: var(--sandstone);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.35rem;
  }
  .progress-fill {
    height: 100%;
    background: var(--verdigris);
    border-radius: 4px;
    transition: width 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .progress-fill { transition: none; }
  }
  .progress-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .progress-label {
    font-weight: 400;
    color: var(--verdigris);
  }
  .map-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .map-tile {
    aspect-ratio: 1;
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .map-tile:hover { border-color: var(--wax-red); }
  .tile-claimed {
    border-color: var(--verdigris);
    background: #e8f0ec;
  }
  .tile-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-decoration: none;
    color: var(--text);
    padding: 0.5rem;
  }
  .tile-seal {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .tile-content {
    text-align: center;
  }
  .tile-name {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .tile-icon {
    display: block;
    font-size: 1rem;
    margin-top: 0.15rem;
  }
  .claimed-list h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }
  .claimed-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .claimed-item a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    font-size: 0.9rem;
  }
  .claimed-item a:hover { border-color: var(--verdigris); }
  .claimed-mark { font-size: 1rem; }
  .claimed-name-de { font-weight: 600; }
  .claimed-name-en {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .empty-state {
    padding: 1rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .export-section {
    margin-top: 2rem;
    padding: 1.5rem 1rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 2px solid var(--amber);
  }
  .export-section h2 { font-size: 1rem; margin-bottom: 0.75rem; }
  .export-section summary { cursor: pointer; font-weight: 600; padding: 0.25rem 0; }
  .export-desc { font-size: 0.85rem; margin-bottom: 0.75rem; }
  .export-result { margin-top: 0.75rem; }
  .export-label { font-weight: 600; font-size: 0.85rem; margin-bottom: 0.25rem; }
  .export-textarea {
    width: 100%;
    padding: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper);
    resize: vertical;
    margin-bottom: 0.5rem;
  }
  .export-feedback {
    font-size: 0.85rem;
    margin-top: 0.35rem;
    min-height: 1.3em;
    color: var(--verdigris);
  }
</style>
