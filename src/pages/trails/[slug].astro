---
import BaseLayout from '../../layouts/BaseLayout.astro';
import trails from '../../data/trails.json';
import sites from '../../../sites.json';

export async function getStaticPaths() {
  return trails.map(trail => ({
    params: { slug: trail.id },
    props: { trail },
  }));
}

const { trail } = Astro.props;
const trailSites = trail.sites.map(slug => sites.find(s => s.slug === slug)).filter(Boolean);
const allAvailable = trailSites.length === trail.sites.length;
const missingSlugs = trail.sites.filter(slug => !sites.some(s => s.slug === slug));
---

<BaseLayout title={`${trail.name.de} – Bamberg Quest`} description={trail.description.de}>
  <nav class="breadcrumb"><a href="/trails">← <span data-i18n="nav.all_trails">Alle Routen</span></a> <a href="/"><span data-i18n="nav.overview">Übersicht</span></a></nav>

  <article>
    <header class="trail-header">
      <h1>{trail.icon} {trail.name.de}</h1>
      <p class="trail-subtitle">{trail.name.en}</p>
      <div class="trail-stats">
        <div class="stat"><span class="stat-value">{trail.distance_km} km</span><span class="stat-label" data-i18n="trail_route">Strecke</span></div>
        <div class="stat"><span class="stat-value">{trail.elevation_m} m</span><span class="stat-label" data-i18n="trail_climb">Aufstieg</span></div>
        <div class="stat"><span class="stat-value">{trail.duration}</span><span class="stat-label" data-i18n="trail_duration">Dauer</span></div>
        <div class="stat"><span class="stat-value">{trail.pace}</span><span class="stat-label" data-i18n="trail_pace">Tempo</span></div>
        {trail.step_free && <div class="stat"><span class="stat-value">♿</span><span class="stat-label" data-i18n="trail_step_free">Schritt-frei</span></div>}
      </div>
      <p class="trail-description lang-de">{trail.description.de}</p>
      <p class="trail-description lang-en">{trail.description.en}</p>
    </header>

    <section class="trail-sites">
      <h2><span data-i18n="trail_subtitle">Stationen</span></h2>
      {!allAvailable && (
        <div class="trail-notice">
          ⚠️ <span data-i18n="trail_missing_stops" data-i18n-params={JSON.stringify({count: trail.sites.length - trailSites.length})}>{trail.sites.length - trailSites.length} Stationen fehlen noch im Guidebook.</span>
          {missingSlugs.length > 0 && <span>Fehlende Slugs: {missingSlugs.join(', ')}</span>}
        </div>
      )}
      <ol class="stop-list" id="stop-list" data-slugs={trail.sites.join(',')}>
        {trail.sites.map((slug, i) => {
          const site = sites.find(s => s.slug === slug);
          if (!site) return null;
          return (
            <li class="stop-item" id={`stop-${slug}`} data-slug={slug}>
              <span class="stop-num">{i + 1}</span>
              <div class="stop-info">
                <a href={`/site/${slug}`} class="stop-name">{site.name.de}</a>
                <span class="stop-en">{site.name.en}</span>
                <span class={`stop-tier tier-${site.tier}`}>{site.tier}</span>
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  </article>

  <footer class="page-footer"><a href="/trails">← <span data-i18n="nav.all_trails">Alle Routen</span></a></footer>
</BaseLayout>

<script>
import { isClaimed } from '../../lib/game.js';

const list = document.getElementById('stop-list');
if (list) {
  const slugs = (list.dataset.slugs || '').split(',').filter(Boolean);
  slugs.forEach(slug => {
    const stop = document.getElementById(`stop-${slug}`);
    if (stop && isClaimed(slug)) stop.classList.add('stop-claimed');
  });
}
</script>

<style>
  .breadcrumb { padding: 1rem 0; font-size: 0.85rem; display: flex; gap: 1rem; }
  .trail-header { margin-bottom: 2rem; }
  .trail-header h1 { font-size: 1.5rem; }
  .trail-subtitle { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem; }
  .trail-stats { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    min-width: 70px;
  }
  .stat-value { font-weight: 700; font-size: 0.9rem; }
  .stat-label { font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .trail-description { font-size: 0.9rem; }
  .trail-sites h2 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .trail-notice {
    padding: 0.5rem 0.75rem;
    background: #f5edd6;
    border-radius: var(--radius);
    border: 1px solid var(--amber);
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }
  .stop-list {
    list-style: none;
    counter-reset: stops;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .stop-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    transition: border-color 0.15s;
  }
  .stop-claimed { border-color: var(--verdigris); opacity: 0.85; }
  .stop-num {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-muted);
    min-width: 1.5rem;
    text-align: center;
  }
  .stop-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    flex: 1;
  }
  .stop-name { font-weight: 600; font-size: 0.95rem; }
  .stop-en { font-size: 0.8rem; color: var(--text-muted); }
  .stop-tier {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .tier-gold { background: var(--amber); color: var(--paper); }
  .tier-silver { background: #b0b0a8; color: var(--paper); }
  .tier-bronze { background: #c49a6a; color: var(--paper); }
  .page-footer { padding: 2rem 0; font-size: 0.85rem; }
</style>
