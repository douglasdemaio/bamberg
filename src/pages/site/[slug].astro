---
import BaseLayout from '../../layouts/BaseLayout.astro';
import sites from '../../../sites.json';

export async function getStaticPaths() {
  return sites.map(site => ({
    params: { slug: site.slug },
    props: { site },
  }));
}

const { site } = Astro.props;
const tierClass = site.tier;
---

<BaseLayout title={`${site.name.de} – Bamberg Quest`} description={`Besuche ${site.name.de} in Bamberg. Öffnungszeiten, Geschichte, Anfahrt.`}>
  <nav class="breadcrumb" aria-label="Brotkrümelnavigation">
    <a href="/"><span data-i18n="site.back">← Zurück zur Übersicht</span></a>
  </nav>

  <article class="site-page">
    <header class="site-header">
      <span class={`tier-badge tier-${tierClass}`} data-tier={site.tier}>
        <span data-i18n={`tier.${site.tier}`}>{site.tier === 'bronze' ? 'Name sichtbar' : site.tier === 'silver' ? 'Rätsel' : site.tier === 'gold' ? 'Rätsel, verschlüsselt' : 'Legendär'}</span>
      </span>
      <h1>{site.name.de}</h1>
      <p class="site-name-en">{site.name.en}</p>
      {site.requires_claimed && site.requires_claimed.length > 0 && (
        <div class="legendary-lock" id="legendary-lock">
          <p>🔒 <strong><span data-i18n="site.legendary">Legendär</span></strong></p>
          <p class="legendary-req" data-i18n="site.legendary_requires" data-i18n-params={JSON.stringify({sites: site.requires_claimed.join(', ')})}>Erfordert: {site.requires_claimed.join(', ')}</p>
        </div>
      )}
      <dl class="meta-list">
        <div class="meta-item">
          <dt><span data-i18n="site.category">Kategorie</span></dt>
          <dd>{site.category}</dd>
        </div>
        <div class="meta-item">
          <dt><span data-i18n="site.coordinates">Koordinaten</span></dt>
          <dd><code>{site.coords[0].toFixed(4)}, {site.coords[1].toFixed(4)}</code></dd>
        </div>
        <div class="meta-item">
          <dt><span data-i18n="site.accessible">Barrierefrei</span></dt>
          <dd>{site.accessible ? <span data-i18n="site.accessible_yes">Ja</span> : <span data-i18n="site.accessible_limited">Eingeschränkt</span>}</dd>
        </div>
      </dl>
    </header>

    <div id="legendary-content" class={site.requires_claimed?.length ? 'legendary-gated' : ''}>

    {site.hours && (
      <section class="info-block">
        <h2><span data-i18n="site.hours_title">Öffnungszeiten</span></h2>
        <p class="lang-de" data-i18n-content data-i18n-content-de={site.hours.de} data-i18n-content-en={site.hours.en}>{site.hours.de}</p>
        <p class="lang-en">{site.hours.en}</p>
        <p class="disclaimer" data-i18n="plan.hours_disclaimer">Die hier angegebenen Öffnungszeiten sind nicht offiziell und können sich jederzeit ändern. Bitte informiere dich vor deinem Besuch auf der offiziellen Website des jeweiligen Ortes.</p>
      </section>
    )}

    <section class="info-block history-block">
      <h2><span data-i18n="site.history_title">Geschichte</span></h2>
      <p class="history-para lang-de" data-i18n-content data-i18n-content-de={'<strong>' + site.history_60w.de + '</strong>'} data-i18n-content-en={'<strong>' + site.history_60w.en + '</strong>'}><strong>{site.history_60w.de}</strong></p>
      <p class="history-para lang-en"><strong>{site.history_60w.en}</strong></p>
    </section>

    <section class="info-block">
      <h2><span data-i18n="site.look_title">Hinsehen</span></h2>
      <p class="lang-de" data-i18n-content data-i18n-content-de={site.look_for.de} data-i18n-content-en={site.look_for.en}>{site.look_for.de}</p>
      <p class="lang-en">{site.look_for.en}</p>
    </section>

    <section class="info-block">
      <h2><span data-i18n="site.photo_title">Foto-Tipp</span></h2>
      <p class="lang-de" data-i18n-content data-i18n-content-de={site.photo_tip.de} data-i18n-content-en={site.photo_tip.en}>{site.photo_tip.de}</p>
      <p class="lang-en">{site.photo_tip.en}</p>
    </section>

    <aside class="riddle-block" aria-label="Rätsel für Spieler">
      <h2><span data-i18n="site.playing_title">🎲 Spielst du?</span></h2>
      <details>
        <summary><span data-i18n="site.show_riddle">Rätsel anzeigen</span></summary>
        {site.riddle && (
          <div class="riddle-content">
            <blockquote>
              <p class="lang-de" data-i18n-content data-i18n-content-de={'<strong>' + site.riddle.de + '</strong>'} data-i18n-content-en={'<strong>' + site.riddle.en + '</strong>'}><strong>{site.riddle.de}</strong></p>
              <p class="lang-en"><strong>{site.riddle.en}</strong></p>
            </blockquote>
            {site.hint && (
              <details class="hint">
                <summary><span data-i18n="site.hint">💡 Hinweis</span></summary>
                <p class="lang-de" data-i18n-content data-i18n-content-de={site.hint.de} data-i18n-content-en={site.hint.en}>{site.hint.de}</p>
                <p class="lang-en">{site.hint.en}</p>
              </details>
            )}
          </div>
        )}
      </details>
    </aside>

    <aside class="claim-block" id="claim-ui" aria-label="Fundort markieren" data-slug={site.slug} data-answers={JSON.stringify(site.answers)} data-requires-claimed={JSON.stringify(site.requires_claimed || [])}>
      <div class="claim-question-data" hidden data-i18n-content data-i18n-content-de={site.question.de} data-i18n-content-en={site.question.en}>{site.question.de}</div>
      <div class="claim-status" id="claim-status">
        <p class="claim-not-claimed"><span data-i18n="site.not_explored">🫱 Noch nicht erkundet</span></p>
        <p class="claim-claimed" hidden><span data-i18n="site.explored">✅ Erkundet</span></p>
      </div>
      <div class="claim-form" id="claim-form" hidden>
        <h3><span data-i18n="site.answer_title">Vor Ort beantworten</span></h3>
        <p class="claim-question" id="claim-question"></p>
        <div class="claim-input-row">
          <input type="text" id="claim-answer" class="claim-input" data-i18n-placeholder="site.answer_placeholder" placeholder="Deine Antwort" autocomplete="off" />
          <button type="button" id="claim-submit" class="claim-btn"><span data-i18n="site.check_btn">Prüfen</span></button>
        </div>
        <p class="claim-feedback" id="claim-feedback" aria-live="polite"></p>
        <details class="claim-honor">
          <summary><span data-i18n="site.honor_title">🌿 Nur hier gewesen</span></summary>
          <p class="honor-note"><span data-i18n="site.honor_text">Keine Frage beantworten? Ein Klick genügt – der Besuch zählt trotzdem.</span></p>
          <button type="button" id="claim-honor" class="claim-btn claim-btn-secondary"><span data-i18n="site.honor_btn">Hier gewesen</span></button>
        </details>
      </div>
    </aside>
  </div>
  </article>

  <footer class="page-footer">
    <a href="/"><span data-i18n="site.back">← Zurück zur Übersicht</span></a>
  </footer>
</BaseLayout>

<script>
import { isClaimed, claimSite, checkAnswer, normalizeAnswer } from '../../lib/game.js';

const slug = document.getElementById('claim-ui')?.dataset.slug;
if (slug) {
  const statusEl = document.getElementById('claim-status');
  const notClaimedEl = statusEl.querySelector('.claim-not-claimed');
  const claimedEl = statusEl.querySelector('.claim-claimed');
  const formEl = document.getElementById('claim-form');
  const questionEl = document.getElementById('claim-question');
  const answerInput = document.getElementById('claim-answer');
  const submitBtn = document.getElementById('claim-submit');
  const feedbackEl = document.getElementById('claim-feedback');
  const honorBtn = document.getElementById('claim-honor');

  const answers = JSON.parse(document.getElementById('claim-ui').dataset.answers);
  const questionDataEl = document.querySelector('.claim-question-data');

  function t(key, lang) {
    var dict = window.__bqTranslations;
    if (!dict) return key;
    var val = dict[lang] && dict[lang][key];
    if (!val && lang !== 'en') val = dict.en && dict.en[key];
    if (!val && lang !== 'de') val = dict.de && dict.de[key];
    return val || key;
  }

  function updateUI() {
    if (isClaimed(slug)) {
      notClaimedEl.hidden = true;
      claimedEl.hidden = false;
      formEl.hidden = true;
    } else {
      notClaimedEl.hidden = false;
      claimedEl.hidden = true;
      formEl.hidden = false;
      questionEl.textContent = questionDataEl ? questionDataEl.textContent : '';
    }
  }

  function handleSubmit() {
    const answer = answerInput.value.trim();
    if (!answer) return;
    if (checkAnswer(answer, answers)) {
      claimSite(slug, 'question');
      feedbackEl.textContent = t('site.correct', document.documentElement.lang);
      feedbackEl.className = 'claim-feedback claim-feedback-ok';
      updateUI();
    } else {
      const cleaned = normalizeAnswer(answer);
      feedbackEl.textContent = t('site.wrong', document.documentElement.lang).replace('{answer}', cleaned);
      feedbackEl.className = 'claim-feedback claim-feedback-err';
    }
  }

  submitBtn.addEventListener('click', handleSubmit);
  answerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSubmit();
  });

  honorBtn.addEventListener('click', () => {
    claimSite(slug, 'honor');
    feedbackEl.textContent = t('site.marked', document.documentElement.lang);
    feedbackEl.className = 'claim-feedback claim-feedback-ok';
    updateUI();
  });

  updateUI();
}

// Legendary gating
const lockEl = document.getElementById('legendary-lock');
const contentEl = document.getElementById('legendary-content');
if (lockEl && contentEl) {
  const reqSlugs = document.getElementById('claim-ui')?.dataset.requiresClaimed;
  if (reqSlugs) {
    const required = JSON.parse(reqSlugs);
    const allClaimed = required.every(s => isClaimed(s));
    if (allClaimed) {
      lockEl.hidden = true;
      contentEl.classList.remove('legendary-gated');
    }
  }
}
</script>

<style>
  .breadcrumb {
    padding: 1rem 0 0.5rem;
    font-size: 0.85rem;
  }
  .site-page {
    padding-bottom: 2rem;
  }
  .site-header {
    margin-bottom: 1.5rem;
  }
  .tier-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    box-shadow: var(--shadow-inset);
    border: 1px solid rgba(0,0,0,0.12);
  }
  .tier-gold { background: linear-gradient(135deg, #d9a852, #b57821); color: #fff; }
  .tier-silver { background: linear-gradient(135deg, #c0bfb6, #8f8e85); color: #fff; }
  .tier-bronze { background: linear-gradient(135deg, #c99a6a, #91663a); color: #fff; }
  .tier-legendary { background: linear-gradient(135deg, #a63431, var(--wax-red)); color: #fff; }
  .site-name-en {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.85rem;
  }
  .meta-item {
    display: flex;
    gap: 0.3rem;
  }
  .meta-item dt {
    color: var(--text-muted);
  }
  .meta-item code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--paper-dark);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }
  .info-block {
    margin-bottom: 1.5rem;
    padding: 1rem 1.1rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .info-block h2 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .info-block p { font-size: 0.9rem; }
  .disclaimer {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-style: italic;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .history-block .history-para::first-letter {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 0.85;
    float: left;
    padding: 0.25rem 0.4rem 0 0;
    color: var(--wax-red);
    font-weight: 700;
  }
  .riddle-block {
    margin-top: 2rem;
    padding: 1rem;
    background: var(--paper-dark);
    border-radius: var(--radius);
    border: 2px solid var(--amber);
  }
  .riddle-block h2 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .riddle-block summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.25rem 0;
  }
  .riddle-block summary:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .riddle-content {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .riddle-content blockquote {
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--amber);
    margin-bottom: 0.75rem;
  }
  .hint {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }
  .hint summary {
    cursor: pointer;
    color: var(--verdigris);
    font-weight: 500;
  }
  .legendary-lock {
    padding: 1rem;
    background: #3d1412;
    color: var(--paper);
    border-radius: var(--radius);
    margin-bottom: 1rem;
    border: 2px solid var(--wax-red);
  }
  .legendary-lock p { margin: 0.25rem 0; }
  .legendary-req { font-size: 0.8rem; opacity: 0.8; }
  .legendary-gated { filter: blur(6px) grayscale(0.6); pointer-events: none; user-select: none; transition: filter 0.5s; }
  .legendary-gated.legendary-unlocked { filter: none; pointer-events: auto; user-select: auto; }
  .claim-block {
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 2px solid var(--verdigris);
  }
  .claim-status {
    margin-bottom: 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .claim-claimed { color: var(--verdigris); }
  .claim-form h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .claim-question {
    font-size: 0.95rem;
    padding: 0.5rem;
    background: var(--paper);
    border-radius: 4px;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
  }
  .claim-input-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .claim-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    font-size: 0.95rem;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper);
    font-family: var(--font-body);
  }
  .claim-input:focus {
    outline: none;
    border-color: var(--wax-red);
    box-shadow: 0 0 0 3px rgba(140,43,39,0.15);
  }
  .claim-btn {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--wax-red);
    color: var(--paper);
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
  }
  .claim-btn:hover { opacity: 0.9; }
  .claim-btn:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .claim-btn-secondary {
    background: var(--verdigris);
    margin-top: 0.5rem;
  }
  .claim-feedback {
    font-size: 0.85rem;
    margin-top: 0.25rem;
    min-height: 1.3em;
  }
  .claim-feedback-ok { color: var(--verdigris); font-weight: 600; }
  .claim-feedback-err { color: var(--wax-red); }
  .claim-honor {
    margin-top: 1rem;
    font-size: 0.85rem;
  }
  .claim-honor summary {
    cursor: pointer;
    color: var(--text-muted);
  }
  .honor-note {
    margin: 0.5rem 0;
    font-size: 0.85rem;
  }
  .page-footer {
    padding: 1rem 0 2rem;
    font-size: 0.85rem;
  }
</style>
