---
import BaseLayout from '../layouts/BaseLayout.astro';
import sites from '../../sites.json';
---

<BaseLayout title="Party – Bamberg Quest" description="Feiere deine Erkundung von Bamberg.">
  <nav class="breadcrumb"><a href="/">← Übersicht</a></nav>

  <span id="party-data" data-total={sites.length} hidden></span>

  <article class="party-page">
    <header class="party-header">
      <h1>🎉 Party!</h1>
    </header>

    <section id="party-unlocked" class="party-content" hidden>
      <div class="party-badge">🏆</div>
      <h2>Glückwunsch! / Congratulations!</h2>
      <p>Du hast ganz Bamberg erkundet. Genieße deinen wohlverdienten Ruhm.</p>
      <p><em>You've explored all of Bamberg. Enjoy your well-earned glory.</em></p>
      <div class="party-fireworks">✨🎆🎇✨</div>
      <a href="/collection" class="party-link">← Zur Sammlung</a>
    </section>

    <section id="party-locked" class="party-content">
      <div class="party-badge">🔒</div>
      <h2>Noch nicht ganz / Not yet</h2>
      <p>Erkunde alle Orte oder gib einen Party-Code ein.</p>
      <p><em>Explore all sites or enter a party code.</em></p>
      <div class="party-code-entry">
        <input type="text" id="party-code-input" class="claim-input" placeholder="Party-Code" autocomplete="off" />
        <button type="button" id="party-code-btn" class="claim-btn">Entsperren / Unlock</button>
      </div>
      <p class="party-feedback" id="party-feedback"></p>
    </section>
  </article>

  <footer class="page-footer"><a href="/">← Übersicht</a></footer>
</BaseLayout>

<script>
import { getClaimedSlugs } from '../lib/game.js';

const totalSites = parseInt(document.getElementById('party-data')?.dataset?.total || '0', 10);

function checkParty() {
  const claimed = getClaimedSlugs().length;
  const unlocked = localStorage.getItem('bamberg_party_unlocked');
  const lockedEl = document.getElementById('party-locked');
  const unlockedEl = document.getElementById('party-unlocked');

  if (unlocked === 'true' || claimed >= totalSites) {
    if (claimed >= totalSites) localStorage.setItem('bamberg_party_unlocked', 'true');
    lockedEl.hidden = true;
    unlockedEl.hidden = false;
  } else {
    lockedEl.hidden = false;
    unlockedEl.hidden = true;
  }
}

document.getElementById('party-code-btn')?.addEventListener('click', () => {
  const code = document.getElementById('party-code-input').value.trim().toLowerCase();
  if (code === 'bamberg-quest-2026') {
    localStorage.setItem('bamberg_party_unlocked', 'true');
    checkParty();
    document.getElementById('party-feedback').textContent = '✓ Entsperrt! / Unlocked!';
  } else {
    document.getElementById('party-feedback').textContent = '✗ Falscher Code / Wrong code';
  }
});

document.getElementById('party-code-input')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') document.getElementById('party-code-btn').click();
});

checkParty();
</script>

<style>
  .breadcrumb { padding: 1rem 0; font-size: 0.85rem; }
  .party-page { 
    display: flex; flex-direction: column; align-items: center;
    padding: 2rem 0;
    min-height: 60vh;
    justify-content: center;
  }
  .party-header h1 { font-size: 2rem; text-align: center; }
  .party-content {
    text-align: center;
    padding: 2rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 2px solid var(--amber);
    max-width: 400px;
    width: 100%;
  }
  .party-badge { font-size: 4rem; margin-bottom: 1rem; }
  .party-fireworks { font-size: 2rem; margin: 1rem 0; letter-spacing: 0.5em; }
  .party-code-entry {
    display: flex; gap: 0.5rem; margin-top: 1rem;
    justify-content: center;
  }
  .party-code-entry input { max-width: 200px; }
  .party-feedback { font-size: 0.85rem; margin-top: 0.5rem; min-height: 1.3em; color: var(--verdigris); }
  .party-link { display: inline-block; margin-top: 1rem; font-size: 0.9rem; }
  .page-footer { padding: 2rem 0; font-size: 0.85rem; text-align: center; }
</style>
